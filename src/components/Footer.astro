---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { footerCopy } from '../content/copy/footer';
import { routes, type CurrentRoute } from '../content/copy/routes';

interface Props {
  lang: 'pt' | 'en';
  showContactLink?: boolean;
  currentRoute: CurrentRoute;
  style?: string;
}

const { lang, showContactLink = true, currentRoute, style } = Astro.props;
const { contact, legalLinks, legalNote } = footerCopy[lang];
const contactHref = routes.contact[lang];
const currentYear = new Date().getFullYear();
---
<footer class="site-footer" data-has-contact-link={showContactLink} style={style}>
  {showContactLink && (
    <a href={contactHref} class="site-footer__contact">{contact}</a>
  )}
  <div class="site-footer__utilities">
    <div class="site-footer__legal-links">
      {legalLinks.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </div>
    <LanguageSwitcher lang={lang} context="footer" currentRoute={currentRoute} />
  </div>
  <div class="site-footer__note">
    <p>{legalNote}</p>
    <p>© {currentYear} UMMUNDU</p>
  </div>
</footer>

<style>
  .site-footer {
    width: 560px;
    display: flex;
    flex-direction: column;
    gap: 71px;
    margin-top: var(--site-footer-margin-top, 219px);
    margin-left: auto;
    font-family: var(--font-body);
  }

  .site-footer[data-has-contact-link='false'] {
    gap: 74px;
  }

  .site-footer__contact {
    align-self: center;
    font-size: var(--text-footer-contact-size);
    line-height: var(--text-footer-contact-line);
  }

  .site-footer__utilities {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .site-footer__legal-links {
    display: flex;
    flex-direction: column;
    gap: 19px;
    font-size: var(--text-footer-legal-size);
    line-height: var(--text-footer-legal-line);
  }

  .site-footer__note {
    text-align: right;
    font-size: var(--text-footer-note-size);
    line-height: var(--text-footer-note-line);
  }

  .site-footer__note p {
    margin: 0;
  }

  @media (max-width: 767px) {
    .site-footer {
      width: 100%;
      margin-left: 0;
      gap: 53px;
      margin-top: var(--mobile-site-footer-margin-top, var(--site-footer-margin-top, 219px));
    }

    .site-footer[data-has-contact-link='false'] {
      gap: 53px;
    }

    .site-footer__contact {
      font-size: var(--mobile-text-footer-contact-size);
      line-height: var(--mobile-text-footer-contact-line);
    }

    .site-footer__legal-links {
      font-size: var(--mobile-text-footer-legal-size);
      line-height: var(--mobile-text-footer-legal-line);
    }

    .site-footer__note {
      display: flex;
      flex-direction: column;
      gap: 5px;
      font-size: var(--mobile-text-footer-note-size);
      line-height: var(--mobile-text-footer-note-line);
    }
  }
</style>
