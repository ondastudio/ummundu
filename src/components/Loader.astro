---
<div class="loader" id="loader">
  <img src="/logo.svg" alt="Ummundu" class="loader__logo" />
</div>

<style>
  .loader {
    position: fixed;
    inset: 0;
    background: var(--color-intro-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 300;
    opacity: 1;
    transition: opacity 250ms ease-out;
  }

  .loader.is-hidden,
  .loader.is-skipped {
    opacity: 0;
    pointer-events: none;
  }

  .loader.is-skipped {
    transition: none;
  }

  .loader__logo {
    width: 151.192px;
    filter: brightness(0) saturate(100%) invert(88%) sepia(8%) saturate(508%) hue-rotate(346deg) brightness(97%) contrast(90%);
  }
</style>

<script is:inline>
  (function () {
    var loader = document.getElementById('loader');
    if (!loader) return;
    var SESSION_KEY = 'ummundu-loader-seen';

    if (sessionStorage.getItem(SESSION_KEY)) {
      loader.classList.add('is-skipped');
      return;
    }

    document.documentElement.style.overflow = 'hidden';
    document.body.style.overflow = 'hidden';

    window.addEventListener('load', function () {
      setTimeout(function () {
        loader.classList.add('is-hidden');
        document.documentElement.style.overflow = '';
        document.body.style.overflow = '';
        sessionStorage.setItem(SESSION_KEY, '1');
      }, 2500);
    });
  })();
</script>
