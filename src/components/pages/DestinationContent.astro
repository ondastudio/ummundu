---
import { marked } from 'marked';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import LabeledSection from '../LabeledSection.astro';
import { splitBilingualBody } from '../../lib/splitBilingualBody';
import type { CollectionEntry } from 'astro:content';
import type { CurrentRoute } from '../../content/copy/routes';

interface Props {
  entry: CollectionEntry<'destinations'>;
  lang: 'pt' | 'en';
}

const { entry, lang } = Astro.props;
const { data, body } = entry;
const sections = splitBilingualBody(body ?? '');
const bodyHtml = marked.parse(sections[lang]) as string;
const title = lang === 'pt' ? data.title_pt : data.title_en;
const country = lang === 'pt' ? data.country_pt : data.country_en;
const currentRoute: CurrentRoute = { destinationId: entry.id };
---
<Header lang={lang} variant="withMenu" />
<main class="destination-page">
  <section class="destination-page__hero">
    <LabeledSection label={country} style="--labeled-section-margin-top: 0; --mobile-labeled-section-margin-top: 0">
      <div class="destination-page__copy">
        <p class="destination-page__title">{title}</p>
        <div class="destination-page__body" set:html={bodyHtml} />
      </div>
    </LabeledSection>
  </section>
</main>
<Footer lang={lang} currentRoute={currentRoute} style="--site-footer-margin-top: 0; --mobile-site-footer-margin-top: 60px" />

<style>
  .destination-page {
    width: 100%;
  }

  .destination-page__hero {
    height: 100vh;
    padding-top: 244px;
  }

  .destination-page__copy {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 560px;
  }

  .destination-page__title {
    font-size: var(--text-page-title-size);
    line-height: var(--text-page-title-line);
    letter-spacing: var(--text-page-title-tracking);
    font-weight: normal;
    margin: 0;
  }

  .destination-page__body {
    font-size: var(--text-body-size);
    line-height: var(--text-body-line);
    letter-spacing: var(--text-body-tracking);
    width: 550px;
  }

  .destination-page__body :global(p) {
    margin: 0;
  }

  @media (max-width: 767px) {
    .destination-page__hero {
      height: 100vh;
      padding-top: 152px;
    }

    .destination-page__copy {
      gap: 17px;
      width: 100%;
    }

    .destination-page__title {
      font-size: var(--mobile-text-page-title-size);
      line-height: var(--mobile-text-page-title-line);
    }

    .destination-page__body {
      font-size: var(--mobile-text-body-size);
      line-height: var(--mobile-text-body-line);
      width: 100%;
    }
  }
</style>
