---
import { getCollection } from 'astro:content';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import LabeledSection from '../LabeledSection.astro';
import { homeCopy } from '../../content/copy/home';
import type { CurrentRoute } from '../../content/copy/routes';

interface Props {
  lang: 'pt' | 'en';
  currentRoute: CurrentRoute;
}

const { lang, currentRoute } = Astro.props;
const t = homeCopy[lang];
const destinations = await getCollection('destinations');
---
<Header lang={lang} variant="logoOnly" />
<main class="home">
  <section class="home__hero">
    <div class="home__menu-area">
      <a href="#menu" class="home__menu-link" data-menu-trigger aria-label={t.menuAriaLabel}>Menu</a>
    </div>
    <a href="#menu" class="home__menu-link-pinned" data-menu-trigger aria-label={t.menuAriaLabel}>Menu</a>
    <h1 class="home__display">
      {t.heroLines.map((line) => <span>{line}</span>)}
    </h1>
    <div class="home__divider"></div>
  </section>

  <LabeledSection
    label={t.essenceLabel}
    style="--labeled-section-margin-top: 167px; --mobile-labeled-section-margin-top: 98px"
  >
    <p>{t.essenceBody}</p>
  </LabeledSection>

  <LabeledSection label={t.approachLabel}>
    <p>{t.approachBody}</p>
  </LabeledSection>

  <LabeledSection label={t.accessLabel}>
    <ul class="home__access-list">
      {t.accessList.map((item) => <li>{item}</li>)}
    </ul>
  </LabeledSection>

  <LabeledSection label={t.destinationsLabel}>
    <ul class="home__destination-list">
      {destinations.map((entry) => (
        <li>
          <a href={lang === 'en' ? `/${entry.id}` : `/pt/${entry.id}`}>
            {lang === 'pt' ? entry.data.title_pt : entry.data.title_en}
          </a>
          {' · '}
          {lang === 'pt' ? entry.data.country_pt : entry.data.country_en}
        </li>
      ))}
    </ul>
  </LabeledSection>
</main>
<Footer lang={lang} currentRoute={currentRoute} style="--mobile-site-footer-margin-top: 143px" />

<style>
  .home {
    width: 100%;
  }

  .home__hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    height: 100vh;
  }

  .home__menu-link,
  .home__menu-link-pinned {
    font-size: var(--text-menu-size);
    line-height: var(--text-menu-line);
    letter-spacing: var(--text-menu-tracking);
    opacity: 1;
    visibility: visible;
    transition: opacity 200ms ease, visibility 0s linear 0s;
  }

  .home__menu-link {
    position: absolute;
    top: 50%;
    right: 0;
    transform: translateY(-100%);
  }

  /* On desktop this wrapper is a no-op (the link stays absolutely
     positioned at the hero's center); on mobile it becomes the "Menu area"
     flex-1 region so the link itself keeps its natural, measurable size
     instead of stretching to fill the available space. */
  .home__menu-area {
    display: contents;
  }

  /* Fades out as it scrolls under the fixed header; visibility switch is
     delayed until the fade finishes so it doesn't vanish mid-transition. */
  .home__menu-link.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 200ms ease, visibility 0s linear 200ms;
  }

  .home__menu-link-pinned {
    position: fixed;
    top: calc(var(--space-header-height) / 2);
    right: var(--space-page-padding);
    transform: translateY(-50%);
    z-index: 20;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 200ms ease, visibility 0s linear 200ms;
  }

  .home__menu-link-pinned.is-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 200ms ease, visibility 0s linear 0s;
  }

  .home__display {
    font-family: var(--font-display);
    font-weight: 200;
    font-size: var(--text-display-size);
    line-height: var(--text-display-line);
    letter-spacing: var(--text-display-tracking);
    text-transform: uppercase;
    margin: auto 0 0;
    align-self: flex-start;
  }

  .home__display span {
    display: block;
  }

  .home__divider {
    width: 100%;
    height: 1px;
    background: var(--color-text-muted-20);
    margin: 30px 0;
  }

  .home__access-list,
  .home__destination-list {
    list-style: none;
    padding: 0;
  }

  .home__access-list li {
    margin-bottom: 9px;
  }

  .home__destination-list li {
    margin-bottom: 20px;
  }

  @media (max-width: 767px) {
    /* The mobile design centers "Menu" within the space above the display
       block, rather than at the hero's own vertical center (the desktop
       trick), so the wrapper (not the link itself) becomes the flex-1
       region — keeping the link's own box sized to its text so scroll
       math measuring it stays accurate. */
    .home__menu-area {
      display: flex;
      flex: 1;
      align-items: center;
      justify-content: flex-end;
      padding-top: 40px;
    }

    .home__menu-link {
      position: static;
      transform: none;
    }

    .home__menu-link-pinned {
      top: calc(var(--mobile-space-header-height) / 2);
      right: var(--mobile-space-page-padding);
    }

    .home__display {
      font-size: var(--mobile-text-display-size);
      line-height: var(--mobile-text-display-line);
      margin: 0;
    }

    .home__divider {
      margin: 23px 0 20px;
    }

    .home__access-list li {
      margin-bottom: 8px;
    }
  }
</style>

<script>
  function initHomeMenuPin() {
    const heroLink = document.querySelector<HTMLElement>('.home__menu-link');
    const pinnedLink = document.querySelector<HTMLElement>('.home__menu-link-pinned');
    const headerLogoLink = document.querySelector<HTMLElement>('.site-header__logo-link');
    const header = document.querySelector<HTMLElement>('.site-header');
    if (!heroLink || !pinnedLink) return;

    // Pins once the hero link is fully covered by the header (its own
    // bottom edge scrolls past the header's bottom edge) — measured from
    // the link itself (not assumed from the hero's center) since its
    // position within the hero differs between the desktop (absolute,
    // hero-centered) and mobile (flex-flow) layouts.
    let pinThreshold = 0;

    const mobilePagePadding = parseFloat(
      getComputedStyle(document.documentElement).getPropertyValue('--mobile-space-page-padding')
    );

    // Measured (not computed via vw math) so the slide lands exactly on the
    // mobile page padding regardless of the logo's rendered width.
    const measureLogoShift = () => {
      if (!headerLogoLink) return;
      const wasPinned = headerLogoLink.classList.contains('is-home-pinned');
      headerLogoLink.classList.remove('is-home-pinned');
      const centeredLeft = headerLogoLink.getBoundingClientRect().left;
      headerLogoLink.classList.toggle('is-home-pinned', wasPinned);
      const shift = mobilePagePadding - centeredLeft;
      headerLogoLink.style.setProperty('--logo-pin-shift', `${shift}px`);
    };

    const measure = () => {
      const headerHeight = header?.getBoundingClientRect().height ?? 0;
      const linkRect = heroLink.getBoundingClientRect();
      const linkBottomFromDocTop = linkRect.bottom + window.scrollY;
      pinThreshold = linkBottomFromDocTop - headerHeight;
      measureLogoShift();
    };

    const update = () => {
      const pinned = window.scrollY >= pinThreshold;
      heroLink.classList.toggle('is-hidden', pinned);
      pinnedLink.classList.toggle('is-visible', pinned);
      headerLogoLink?.classList.toggle('is-home-pinned', pinned);
    };

    measure();
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', () => {
      measure();
      update();
    });
  }

  initHomeMenuPin();
</script>
