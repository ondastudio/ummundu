---
import { getCollection } from 'astro:content';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import { contactCopy } from '../../content/copy/contact';
import { getDepartureYears } from '../../lib/getDepartureYears';
import { routes, type CurrentRoute } from '../../content/copy/routes';

interface Props {
  lang: 'pt' | 'en';
  currentRoute: CurrentRoute;
}

const { lang, currentRoute } = Astro.props;
const t = contactCopy[lang];
const destinations = await getCollection('destinations');
const years = getDepartureYears(new Date().getFullYear(), 2);
const privacyHref = routes.privacy[lang];
const successRedirect = routes.contactSuccess[lang];
---
<Header lang={lang} variant="withMenu" />
<main class="contact">
  <p class="contact__label">{t.label}</p>

  <div class="contact__content">
  <p class="contact__intro">{t.intro}</p>

  <form class="contact__form" action="https://formspree.io/f/REPLACE_WITH_FORM_ID" method="POST" novalidate data-contact-form>
    <input type="hidden" name="_next" value={`https://REPLACE_WITH_DOMAIN${successRedirect}`} />

    <div class="contact__field">
      <div class="contact__row">
        <label class="contact__field-label" for={`departure-month-${lang}`}>{t.fields.departure}</label>
        <div class="contact__field-group">
          <div class="dropdown">
            <button
              type="button"
              id={`departure-month-${lang}`}
              class="dropdown__trigger"
              data-dropdown-trigger="departure_month"
              aria-haspopup="listbox"
              aria-expanded="false"
              aria-controls={`departure-month-panel-${lang}`}
            >
              <span class="dropdown__value" data-dropdown-value>{t.fields.month}</span>
              <span class="dropdown__chevron"><svg class="dropdown__chevron-icon" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" />
              </svg></span>
            </button>
          </div>
          <div class="dropdown">
            <button
              type="button"
              id={`departure-year-${lang}`}
              class="dropdown__trigger"
              data-dropdown-trigger="departure_year"
              aria-haspopup="listbox"
              aria-expanded="false"
              aria-controls={`departure-year-panel-${lang}`}
            >
              <span class="dropdown__value" data-dropdown-value>{t.fields.year}</span>
              <span class="dropdown__chevron"><svg class="dropdown__chevron-icon" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" />
              </svg></span>
            </button>
          </div>
        </div>
      </div>
      <ul class="dropdown__panel" id={`departure-month-panel-${lang}`} data-dropdown-panel="departure_month" role="listbox" hidden>
        {t.months.map((month) => <li role="option" data-value={month} tabindex="-1">{month}</li>)}
      </ul>
      <ul class="dropdown__panel" id={`departure-year-panel-${lang}`} data-dropdown-panel="departure_year" role="listbox" hidden>
        {years.map((year) => <li role="option" data-value={String(year)} tabindex="-1">{year}</li>)}
      </ul>
      <input type="hidden" name="departure_month" data-dropdown-input="departure_month" />
      <input type="hidden" name="departure_year" data-dropdown-input="departure_year" />
    </div>

    <div class="contact__field">
      <div class="contact__row">
        <label class="contact__field-label" for={`destination-${lang}`}>{t.fields.destination} <span class="contact__required">*</span></label>
        <div class="dropdown dropdown--full">
          <button
            type="button"
            id={`destination-${lang}`}
            class="dropdown__trigger"
            data-dropdown-trigger="destination"
            aria-haspopup="listbox"
            aria-expanded="false"
            aria-controls={`destination-panel-${lang}`}
          >
            <span class="dropdown__value" data-dropdown-value></span>
            <span class="dropdown__chevron"><svg class="dropdown__chevron-icon" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" />
              </svg></span>
          </button>
        </div>
      </div>
      <ul class="dropdown__panel" id={`destination-panel-${lang}`} data-dropdown-panel="destination" role="listbox" hidden>
        {destinations.map((entry) => (
          <li role="option" data-value={entry.id} tabindex="-1">
            {lang === 'pt' ? entry.data.title_pt : entry.data.title_en}
            {' · '}
            {lang === 'pt' ? entry.data.country_pt : entry.data.country_en}
          </li>
        ))}
      </ul>
      <input type="hidden" name="destination" data-dropdown-input="destination" data-required />
      <p class="contact__error" data-error hidden>{t.requiredNote}</p>
    </div>

    <div class="contact__field">
      <div class="contact__row">
        <label class="contact__field-label" for={`duration-${lang}`}>{t.fields.duration} <span class="contact__required">*</span></label>
        <div class="dropdown dropdown--full">
          <button
            type="button"
            id={`duration-${lang}`}
            class="dropdown__trigger"
            data-dropdown-trigger="duration"
            aria-haspopup="listbox"
            aria-expanded="false"
            aria-controls={`duration-panel-${lang}`}
          >
            <span class="dropdown__value" data-dropdown-value></span>
            <span class="dropdown__chevron"><svg class="dropdown__chevron-icon" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" />
              </svg></span>
          </button>
        </div>
      </div>
      <ul class="dropdown__panel" id={`duration-panel-${lang}`} data-dropdown-panel="duration" role="listbox" hidden>
        {t.durations.map((duration) => <li role="option" data-value={duration} tabindex="-1">{duration}</li>)}
      </ul>
      <input type="hidden" name="duration" data-dropdown-input="duration" data-required />
      <p class="contact__error" data-error hidden>{t.requiredNote}</p>
    </div>

    <div class="contact__field">
      <div class="contact__row">
        <label class="contact__field-label" for={`travellers-${lang}`}>{t.fields.travellers} <span class="contact__required">*</span></label>
        <div class="dropdown dropdown--full">
          <button
            type="button"
            id={`travellers-${lang}`}
            class="dropdown__trigger"
            data-dropdown-trigger="travellers"
            aria-haspopup="listbox"
            aria-expanded="false"
            aria-controls={`travellers-panel-${lang}`}
          >
            <span class="dropdown__value" data-dropdown-value></span>
            <span class="dropdown__chevron"><svg class="dropdown__chevron-icon" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" />
              </svg></span>
          </button>
        </div>
      </div>
      <ul class="dropdown__panel" id={`travellers-panel-${lang}`} data-dropdown-panel="travellers" role="listbox" hidden>
        {t.travellerOptions.map((option) => <li role="option" data-value={option} tabindex="-1">{option}</li>)}
      </ul>
      <input type="hidden" name="travellers" data-dropdown-input="travellers" data-required />
      <p class="contact__error" data-error hidden>{t.requiredNote}</p>
    </div>

    <div class="contact__field">
      <div class="contact__row">
        <label class="contact__field-label" for={`investment-${lang}`}>{t.fields.investment} <span class="contact__required">*</span></label>
        <div class="dropdown dropdown--full">
          <button
            type="button"
            id={`investment-${lang}`}
            class="dropdown__trigger"
            data-dropdown-trigger="investment"
            aria-haspopup="listbox"
            aria-expanded="false"
            aria-controls={`investment-panel-${lang}`}
          >
            <span class="dropdown__value" data-dropdown-value></span>
            <span class="dropdown__chevron"><svg class="dropdown__chevron-icon" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" />
              </svg></span>
          </button>
        </div>
      </div>
      <ul class="dropdown__panel" id={`investment-panel-${lang}`} data-dropdown-panel="investment" role="listbox" hidden>
        {t.investmentOptions.map((option) => <li role="option" data-value={option} tabindex="-1">{option}</li>)}
      </ul>
      <input type="hidden" name="investment" data-dropdown-input="investment" data-required />
      <p class="contact__error" data-error hidden>{t.requiredNote}</p>
    </div>

    <div class="contact__field contact__field--group-start">
      <div class="contact__row">
        <label class="contact__field-label" for={`first-name-${lang}`}>{t.fields.firstName} <span class="contact__required">*</span></label>
        <input type="text" id={`first-name-${lang}`} name="first_name" required />
      </div>
      <p class="contact__error" data-error hidden>{t.requiredNote}</p>
    </div>

    <div class="contact__field">
      <div class="contact__row">
        <label class="contact__field-label" for={`last-name-${lang}`}>{t.fields.lastName} <span class="contact__required">*</span></label>
        <input type="text" id={`last-name-${lang}`} name="last_name" required />
      </div>
      <p class="contact__error" data-error hidden>{t.requiredNote}</p>
    </div>

    <div class="contact__field">
      <div class="contact__row">
        <label class="contact__field-label" for={`email-${lang}`}>{t.fields.email} <span class="contact__required">*</span></label>
        <input type="email" id={`email-${lang}`} name="email" required />
      </div>
      <p class="contact__error" data-error hidden>{t.requiredNote}</p>
    </div>

    <div class="contact__field">
      <div class="contact__row">
        <label class="contact__field-label" for={`phone-${lang}`}>{t.fields.phone}</label>
        <input type="tel" id={`phone-${lang}`} name="phone" />
      </div>
    </div>

    <div class="contact__field contact__field--message">
      <label class="contact__field-label" for={`message-${lang}`}>{t.fields.message}</label>
      <textarea id={`message-${lang}`} name="message"></textarea>
    </div>

    <p class="contact__required-note">{t.requiredNote}</p>
    <p class="contact__privacy-note">
      {t.privacyPrefix}<a href={privacyHref}>{t.privacyLinkLabel}</a>{t.privacySuffix}
    </p>

    <button type="submit" class="contact__submit">{t.submit}</button>
  </form>
  </div>
</main>
<Footer lang={lang} showContactLink={false} currentRoute={currentRoute} style="--site-footer-margin-top: 0" />

<style>
  .contact {
    width: 100%;
    margin-bottom: 152px;
  }

  .contact__label {
    position: fixed;
    top: 244px;
    left: var(--space-page-padding);
    z-index: 5;
    font-size: var(--text-label-size);
    line-height: var(--text-label-line);
    letter-spacing: var(--text-label-tracking);
    text-transform: uppercase;
    color: var(--color-text-muted-70);
    margin: 0;
  }

  .contact__content {
    width: var(--content-block-width);
    margin-left: auto;
    padding-top: calc(244px + var(--text-label-line));
  }

  .contact__intro {
    font-size: var(--text-body-size);
    line-height: var(--text-body-line);
    letter-spacing: var(--text-body-tracking);
    margin: 0 0 68px;
  }

  .contact__form {
    width: var(--content-block-width);
    display: flex;
    flex-direction: column;
    gap: 35px;
  }

  .contact__field {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .contact__row {
    display: flex;
    align-items: center;
    gap: 37px;
    width: 100%;
    border-bottom: 1px solid var(--color-text-muted-20);
    padding-bottom: 4px;
    transition: border-color 150ms ease;
  }

  .contact__row:has(input:focus),
  .contact__row:has(textarea:focus) {
    border-color: var(--color-text);
  }

  .contact__field-label {
    flex-shrink: 0;
    font-size: var(--text-form-label-size);
    line-height: var(--text-form-label-line);
    letter-spacing: var(--text-form-label-tracking);
    white-space: nowrap;
  }

  .contact__field input {
    flex: 1 1 0%;
    min-width: 0;
    font-family: var(--font-body);
    font-size: var(--text-form-label-size);
    border: none;
    background: transparent;
    color: var(--color-text-muted-70);
    padding: 0;
    outline: none;
  }

  .contact__field textarea {
    width: 100%;
    font-family: var(--font-body);
    font-size: var(--text-form-label-size);
    border: none;
    background: transparent;
    color: var(--color-text-muted-70);
    padding: 0;
    outline: none;
  }

  .contact__field-group {
    display: flex;
    flex: 1 1 0%;
    align-items: center;
    gap: 37px;
    min-width: 0;
  }

  .contact__field--message textarea {
    border: 1px solid var(--color-text-muted-20);
    padding: 6px 10px;
    height: 92px;
    resize: none;
    overflow-y: auto;
    transition: border-color 150ms ease;
    scrollbar-width: thin;
    scrollbar-color: var(--color-text-muted-20) transparent;
  }

  .contact__field--message textarea::-webkit-scrollbar {
    width: 6px;
  }

  .contact__field--message textarea::-webkit-scrollbar-track {
    background: transparent;
  }

  .contact__field--message textarea::-webkit-scrollbar-thumb {
    background-color: var(--color-text-muted-20);
    border-radius: 3px;
  }

  .contact__field--message textarea:focus {
    border-color: var(--color-text);
  }

  .contact__required {
    font-weight: 300;
  }

  .contact__required-note,
  .contact__privacy-note {
    font-size: var(--text-form-meta-size);
    line-height: var(--text-form-meta-line);
    letter-spacing: var(--text-form-meta-tracking);
    margin: 0;
  }

  .contact__required-note--error {
    color: var(--color-error);
  }

  .contact__error {
    font-size: var(--text-form-meta-size);
    line-height: var(--text-form-meta-line);
    letter-spacing: var(--text-form-meta-tracking);
    color: var(--color-error);
    margin: 0;
  }

  .contact__submit {
    align-self: center;
    font-family: var(--font-body);
    font-size: var(--text-cta-size);
    line-height: var(--text-cta-line);
    letter-spacing: var(--text-cta-tracking);
    background: transparent;
    border: 1px solid var(--color-text-muted-20);
    padding: 8px 40px;
    cursor: pointer;
    color: var(--color-text);
    transition: background 150ms ease;
  }

  .contact__submit:hover,
  .contact__submit:focus-visible {
    background: var(--color-text-muted-10);
    outline: none;
  }

  /* Dropdown */

  .dropdown {
    flex: 1 1 0%;
    min-width: 0;
  }

  .dropdown--full {
    width: 100%;
  }

  .dropdown__trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    width: 100%;
    font-family: var(--font-body);
    font-size: var(--text-form-label-size);
    line-height: var(--text-form-label-line);
    letter-spacing: var(--text-form-label-tracking);
    background: transparent;
    border: none;
    padding: 0;
    color: var(--color-text-muted-50);
    text-align: left;
    cursor: pointer;
  }

  .dropdown__trigger[data-has-value] {
    color: var(--color-text-muted-70);
  }

  .dropdown__value {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dropdown__chevron {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    color: var(--color-text-muted-70);
  }

  .dropdown__chevron-icon {
    transition: transform 150ms ease;
  }

  .dropdown__trigger[aria-expanded='true'] .dropdown__chevron-icon {
    transform: rotate(180deg);
  }

  .dropdown__panel {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 15;
    width: 100%;
    max-height: 320px;
    overflow-y: auto;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
    background: var(--color-bg);
    border: 1px solid var(--color-text-muted-40);
    scrollbar-width: thin;
    scrollbar-color: var(--color-text-muted-20) transparent;
  }

  .dropdown__panel::-webkit-scrollbar {
    width: 6px;
  }

  .dropdown__panel::-webkit-scrollbar-track {
    background: transparent;
  }

  .dropdown__panel::-webkit-scrollbar-thumb {
    background-color: var(--color-text-muted-20);
    border-radius: 3px;
  }

  .dropdown__panel[hidden] {
    display: none;
  }

  .dropdown__panel li {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    padding: 0 10px;
    font-family: var(--font-body);
    font-size: var(--text-form-label-size);
    line-height: var(--text-form-label-line);
    letter-spacing: var(--text-form-label-tracking);
    color: var(--color-text-muted-70);
    text-align: center;
    cursor: pointer;
    transition: background 150ms ease, color 150ms ease;
  }

  .dropdown__panel li:hover,
  .dropdown__panel li:focus-visible,
  .dropdown__panel li[aria-selected='true'] {
    background: var(--color-text-muted-10);
    color: var(--color-text);
    outline: none;
  }

  @media (min-width: 768px) and (max-width: 1024px) {
    .contact__label {
      left: var(--tablet-space-page-padding);
    }
  }

  @media (max-width: 767px) {
    .contact {
      margin-bottom: 114px;
    }

    .contact__label {
      position: static;
      padding-top: 152px;
      font-size: var(--mobile-text-label-size);
      line-height: var(--mobile-text-label-line);
    }

    .contact__content {
      width: 100%;
      margin-left: 0;
      padding-top: 30px;
    }

    .contact__intro {
      font-size: var(--mobile-text-body-size);
      line-height: var(--mobile-text-body-line);
      margin: 0 0 50px;
    }

    .contact__form {
      width: 100%;
      gap: 0;
    }

    .contact__field {
      margin-top: 34px;
    }

    .contact__field:first-child {
      margin-top: 0;
    }

    .contact__field--group-start {
      margin-top: 46px;
    }

    .contact__row {
      gap: 36px;
    }

    .contact__field-label {
      font-size: var(--mobile-text-form-label-size);
      line-height: var(--mobile-text-form-label-line);
    }

    .contact__field input,
    .contact__field textarea {
      font-size: var(--mobile-text-form-label-size);
    }

    .contact__field-group {
      gap: 36px;
    }

    .contact__required-note,
    .contact__privacy-note,
    .contact__error {
      font-size: var(--mobile-text-form-meta-size);
      line-height: var(--mobile-text-form-meta-line);
    }

    .contact__required-note {
      margin-top: 46px;
    }

    .contact__privacy-note {
      margin-top: 10px;
    }

    .contact__submit {
      font-size: var(--mobile-text-cta-size);
      line-height: var(--mobile-text-cta-line);
      padding: 6px 40px;
      margin-top: 56px;
    }

    .dropdown__trigger {
      font-size: var(--mobile-text-form-label-size);
      line-height: var(--mobile-text-form-label-line);
    }

    .dropdown__chevron {
      width: 16px;
      height: 16px;
    }

    .dropdown__panel li {
      font-size: var(--mobile-text-form-label-size);
      line-height: var(--mobile-text-form-label-line);
    }
  }
</style>

<script>
  function updateRequiredNote() {
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    if (!form) return;
    const requiredNote = document.querySelector<HTMLElement>('.contact__required-note');
    const hasVisibleError = Array.from(form.querySelectorAll<HTMLElement>('[data-error]')).some(
      (el) => !el.hidden
    );
    requiredNote?.classList.toggle('contact__required-note--error', hasVisibleError);
  }

  function initDropdowns() {
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    if (!form) return;

    const triggers = Array.from(form.querySelectorAll<HTMLButtonElement>('[data-dropdown-trigger]'));

    function getParts(trigger: HTMLButtonElement) {
      const key = trigger.dataset.dropdownTrigger as string;
      const field = trigger.closest('.contact__field') as HTMLElement;
      const panel = field.querySelector<HTMLElement>(`[data-dropdown-panel="${key}"]`)!;
      const input = field.querySelector<HTMLInputElement>(`[data-dropdown-input="${key}"]`)!;
      const valueEl = trigger.querySelector<HTMLElement>('[data-dropdown-value]')!;
      return { field, panel, input, valueEl };
    }

    function clearFieldError(field: HTMLElement) {
      const errorEl = field.querySelector<HTMLElement>('[data-error]');
      if (errorEl) errorEl.hidden = true;
      updateRequiredNote();
    }

    function closeDropdown(trigger: HTMLButtonElement) {
      const { panel } = getParts(trigger);
      trigger.setAttribute('aria-expanded', 'false');
      panel.hidden = true;
    }

    function closeAll(except?: HTMLButtonElement) {
      triggers.forEach((t) => {
        if (t !== except) closeDropdown(t);
      });
    }

    function openDropdown(trigger: HTMLButtonElement) {
      closeAll(trigger);
      const { panel, input } = getParts(trigger);
      trigger.setAttribute('aria-expanded', 'true');
      panel.hidden = false;
      const options = Array.from(panel.querySelectorAll<HTMLElement>('[role="option"]'));
      const selected = options.find((o) => o.dataset.value === input.value) ?? options[0];
      selected?.focus();
    }

    function selectOption(trigger: HTMLButtonElement, option: HTMLElement) {
      const { input, valueEl, panel, field } = getParts(trigger);
      input.value = option.dataset.value ?? '';
      input.dispatchEvent(new Event('change', { bubbles: true }));
      valueEl.textContent = option.textContent ?? '';
      trigger.dataset.hasValue = 'true';
      panel.querySelectorAll('[role="option"]').forEach((o) => o.removeAttribute('aria-selected'));
      option.setAttribute('aria-selected', 'true');
      closeDropdown(trigger);
      trigger.focus();
      clearFieldError(field);
    }

    triggers.forEach((trigger) => {
      const { panel } = getParts(trigger);

      trigger.addEventListener('click', () => {
        const isOpen = trigger.getAttribute('aria-expanded') === 'true';
        if (isOpen) {
          closeDropdown(trigger);
        } else {
          openDropdown(trigger);
        }
      });

      trigger.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown' || event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          openDropdown(trigger);
        }
      });

      panel.addEventListener('click', (event) => {
        const option = (event.target as HTMLElement).closest<HTMLElement>('[role="option"]');
        if (option) selectOption(trigger, option);
      });

      panel.addEventListener('keydown', (event) => {
        const options = Array.from(panel.querySelectorAll<HTMLElement>('[role="option"]'));
        const currentIndex = options.indexOf(document.activeElement as HTMLElement);

        if (event.key === 'ArrowDown') {
          event.preventDefault();
          options[Math.min(currentIndex + 1, options.length - 1)]?.focus();
        } else if (event.key === 'ArrowUp') {
          event.preventDefault();
          options[Math.max(currentIndex - 1, 0)]?.focus();
        } else if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          const active = document.activeElement as HTMLElement;
          if (options.includes(active)) selectOption(trigger, active);
        } else if (event.key === 'Escape') {
          event.preventDefault();
          closeDropdown(trigger);
          trigger.focus();
        } else if (event.key === 'Tab') {
          closeDropdown(trigger);
        }
      });
    });

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Node)) return;
      triggers.forEach((trigger) => {
        if (trigger.getAttribute('aria-expanded') !== 'true') return;
        const field = trigger.closest('.contact__field');
        if (field && !field.contains(event.target as Node)) {
          closeDropdown(trigger);
        }
      });
    });
  }

  function initContactForm() {
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    if (!form) return;

    // Combined in DOM order so "first field with error" reflects visual top-to-bottom order,
    // since dropdown fields sit earlier in the form than the native name/email inputs.
    const requiredFields = Array.from(
      form.querySelectorAll<HTMLElement>(
        'input[required], textarea[required], [data-dropdown-input][data-required]'
      )
    );

    function showError(field: HTMLElement, show: boolean) {
      const errorEl = field.closest('.contact__field')?.querySelector<HTMLElement>('[data-error]');
      if (errorEl) errorEl.hidden = !show;
    }

    form.addEventListener('submit', (event) => {
      let firstInvalid: HTMLElement | null = null;

      requiredFields.forEach((field) => {
        const isDropdownField = field.hasAttribute('data-dropdown-input');
        const isValid = isDropdownField
          ? (field as HTMLInputElement).value.trim() !== ''
          : (field as HTMLInputElement | HTMLTextAreaElement).checkValidity();

        showError(field, !isValid);

        if (!isValid && !firstInvalid) {
          firstInvalid = isDropdownField
            ? field.closest('.contact__field')?.querySelector<HTMLElement>('[data-dropdown-trigger]') ?? null
            : field;
        }
      });

      updateRequiredNote();

      if (firstInvalid) {
        event.preventDefault();
        (firstInvalid as HTMLElement).scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        (firstInvalid as HTMLElement).focus({ preventScroll: true });
      }
    });
  }

  initDropdowns();
  initContactForm();
</script>
