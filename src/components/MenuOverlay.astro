---
import { getCollection } from 'astro:content';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { menuOverlayCopy } from '../content/copy/menuOverlay';
import { routes, type CurrentRoute } from '../content/copy/routes';

interface Props {
  lang: 'pt' | 'en';
  currentRoute: CurrentRoute;
}

const { lang, currentRoute } = Astro.props;
const destinations = await getCollection('destinations');
const t = menuOverlayCopy[lang];
const contactHref = routes.contact[lang];
const destinationHref = (id: string) => (lang === 'en' ? `/${id}` : `/pt/${id}`);
---
<div class="menu-overlay" data-menu-overlay data-state="closed">
  <div class="menu-overlay__backdrop" data-menu-backdrop></div>
  <div class="menu-overlay__panel" data-menu-panel>
    <div class="menu-overlay__panel-top">
      <a href={routes.home[lang]} class="menu-overlay__logo-link">
        <img src="/logo.svg" alt="Ummundu" class="menu-overlay__logo" />
      </a>
      <a href="#close" class="menu-overlay__close" data-menu-close>{t.close}</a>
    </div>

    <div class="menu-overlay__states">
      <div class="menu-overlay__state1" data-panel-state1>
        <nav class="menu-overlay__nav">
          <a href="#destinos" data-menu-destinos>{t.destinations}</a>
          <a href={contactHref}>{t.contact}</a>
        </nav>
        <div class="menu-overlay__language">
          <LanguageSwitcher lang={lang} context="menu" currentRoute={currentRoute} />
        </div>
      </div>

      <div class="menu-overlay__state2" data-panel-state2>
        <p class="menu-overlay__eyebrow">{t.destinationsLabel}</p>
        <ul class="menu-overlay__destination-list">
          {destinations.map((entry) => (
            <li>
              <a href={destinationHref(entry.id)}>
                {lang === 'pt' ? entry.data.title_pt : entry.data.title_en}
              </a>
              {' · '}
              {lang === 'pt' ? entry.data.country_pt : entry.data.country_en}
            </li>
          ))}
        </ul>
        <a href="#back" class="menu-overlay__back" data-menu-back>{t.back}</a>
      </div>
    </div>
  </div>
</div>

<style>
  .menu-overlay {
    position: fixed;
    inset: 0;
    visibility: hidden;
    pointer-events: none;
    z-index: 200;
    /* Stay visible for the 150ms opacity fade-out to play before
       vanishing; open instantly (see the override below). */
    transition: visibility 0s linear 150ms;
  }

  .menu-overlay[data-state='state1'],
  .menu-overlay[data-state='state2'] {
    visibility: visible;
    pointer-events: auto;
    transition: visibility 0s linear 0s;
  }

  .menu-overlay__backdrop {
    position: absolute;
    inset: 0;
    background: var(--color-overlay-backdrop);
  }

  .menu-overlay__panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: var(--content-block-width);
    background: var(--color-bg);
    padding: 0 var(--space-page-padding) 28px;
    display: flex;
    flex-direction: column;
    opacity: 0;
    transition: opacity 150ms ease;
  }

  .menu-overlay[data-state='state1'] .menu-overlay__panel,
  .menu-overlay[data-state='state2'] .menu-overlay__panel {
    opacity: 1;
  }

  .menu-overlay__panel-top {
    height: var(--space-header-height);
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .menu-overlay__logo-link {
    display: none;
    text-decoration: none;
  }

  .menu-overlay__logo {
    height: 16.92px;
    width: 151.192px;
  }

  .menu-overlay__close,
  .menu-overlay__back {
    font-size: var(--text-menu-size);
    line-height: var(--text-menu-line);
    letter-spacing: var(--text-menu-tracking);
    text-transform: capitalize;
  }

  /* Positioned wrapper so state1/state2 can stack on top of each other and
     crossfade without a layout jump (see the two rules below). */
  .menu-overlay__states {
    position: relative;
    flex: 1;
  }

  .menu-overlay__state1,
  .menu-overlay__state2 {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    opacity: 0;
    visibility: hidden;
    transition: opacity 150ms ease, visibility 0s linear 150ms;
  }

  .menu-overlay__state1 {
    align-items: center;
    justify-content: center;
  }

  .menu-overlay__state2 {
    padding-top: 127px;
    gap: 69px;
  }

  .menu-overlay[data-state='state1'] .menu-overlay__state1,
  .menu-overlay[data-state='state2'] .menu-overlay__state2 {
    opacity: 1;
    visibility: visible;
    transition: opacity 150ms ease, visibility 0s linear 0s;
  }

  .menu-overlay__nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    font-size: var(--text-menu-link-size);
    line-height: var(--text-menu-link-line);
    letter-spacing: var(--text-menu-link-tracking);
    text-align: center;
  }

  .menu-overlay__language {
    position: absolute;
    /* 0, not 28px: the containing block is now .menu-overlay__state1, whose
       box already stops at the panel's content edge (the panel's own 28px
       bottom padding is outside this box), so no extra offset is needed to
       land in the same visual spot as before. */
    bottom: 0;
  }

  .menu-overlay__eyebrow {
    font-size: var(--text-label-size);
    line-height: var(--text-label-line);
    letter-spacing: var(--text-label-tracking);
    text-transform: uppercase;
    color: var(--color-text-muted-70);
    margin: 0;
  }

  .menu-overlay__destination-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 21px;
    font-size: var(--text-body-size);
    line-height: var(--text-body-line);
    letter-spacing: var(--text-body-tracking);
  }

  .menu-overlay__back {
    margin-top: auto;
    align-self: center;
  }

  @media (min-width: 768px) and (max-width: 1024px) {
    .menu-overlay__panel {
      padding: 0 var(--tablet-space-page-padding) 28px;
    }
  }

  @media (max-width: 767px) {
    .menu-overlay__panel {
      width: 100%;
      padding: 0 var(--mobile-space-page-padding) var(--mobile-space-page-padding);
    }

    .menu-overlay__panel-top {
      height: var(--mobile-space-header-height);
      justify-content: space-between;
    }

    .menu-overlay__logo-link {
      display: flex;
    }

    .menu-overlay__logo {
      width: 125.993px;
      height: 14.1px;
    }

    .menu-overlay__close,
    .menu-overlay__back {
      font-size: var(--mobile-text-menu-size);
      line-height: var(--mobile-text-menu-line);
    }

    .menu-overlay__nav {
      gap: 20px;
      font-size: var(--mobile-text-menu-link-size);
      line-height: var(--mobile-text-menu-link-line);
    }

    .menu-overlay__language {
      left: 50%;
      transform: translateX(-50%);
    }

    .menu-overlay__state2 {
      padding-top: 152px;
      gap: 30px;
    }

    .menu-overlay__eyebrow {
      font-size: var(--mobile-text-label-size);
      line-height: var(--mobile-text-label-line);
    }

    .menu-overlay__destination-list {
      font-size: var(--mobile-text-body-size);
      line-height: var(--mobile-text-body-line);
    }
  }
</style>

<style is:global>
  body.menu-open {
    overflow: hidden;
  }
</style>

<script>
  function initMenuOverlay() {
    const overlay = document.querySelector<HTMLElement>('[data-menu-overlay]');
    if (!overlay) return;

    const setState = (state: 'closed' | 'state1' | 'state2') => {
      overlay.dataset.state = state;
      document.body.classList.toggle('menu-open', state !== 'closed');
    };

    document.querySelectorAll('[data-menu-trigger]').forEach((trigger) => {
      trigger.addEventListener('click', (event) => {
        event.preventDefault();
        setState('state1');
      });
    });

    overlay.querySelectorAll('[data-menu-close]').forEach((button) => {
      button.addEventListener('click', (event) => {
        event.preventDefault();
        setState('closed');
      });
    });

    overlay.querySelector('[data-menu-backdrop]')?.addEventListener('click', () => {
      setState('closed');
    });

    overlay.querySelector('[data-menu-destinos]')?.addEventListener('click', (event) => {
      event.preventDefault();
      setState('state2');
    });

    overlay.querySelector('[data-menu-back]')?.addEventListener('click', (event) => {
      event.preventDefault();
      setState('state1');
    });
  }

  initMenuOverlay();
</script>
