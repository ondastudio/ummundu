---
import { headerCopy } from '../content/copy/header';
import { routes } from '../content/copy/routes';

interface Props {
  lang: 'pt' | 'en';
  variant?: 'withMenu' | 'logoOnly';
}

const { lang, variant = 'withMenu' } = Astro.props;
const { menuAriaLabel } = headerCopy[lang];
---
<header class="site-header" data-variant={variant}>
  <a href={routes.home[lang]} class="site-header__logo-link">
    <img src="/logo.svg" alt="Ummundu" class="site-header__logo" />
  </a>
  {variant === 'withMenu' && (
    <a href="#menu" class="site-header__menu-link" data-menu-trigger aria-label={menuAriaLabel}>menu</a>
  )}
</header>

<style>
  .site-header {
    height: var(--space-header-height);
    background: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
    padding: 0 var(--space-page-padding);
  }

  .site-header__logo-link {
    display: flex;
    text-decoration: none;
  }

  .site-header__logo {
    height: 16.92px;
    width: 151.192px;
  }

  .site-header__menu-link {
    position: absolute;
    right: var(--space-page-padding);
    font-size: var(--text-menu-size);
    line-height: var(--text-menu-line);
    letter-spacing: var(--text-menu-tracking);
    text-transform: capitalize;
  }

  @media (min-width: 768px) and (max-width: 1024px) {
    .site-header {
      padding: 0 var(--tablet-space-page-padding);
    }

    .site-header__menu-link {
      right: var(--tablet-space-page-padding);
    }
  }

  @media (max-width: 767px) {
    .site-header {
      height: var(--mobile-space-header-height);
      padding: 0 var(--mobile-space-page-padding);
    }

    .site-header__menu-link {
      right: var(--mobile-space-page-padding);
    }

    .site-header__logo {
      width: 125.993px;
      height: 14.1px;
    }

    /* Pages with the menu link already in the bar have no hero to scroll
       past, so the logo sits left-aligned from the start instead of
       animating in like the Home page's scroll-triggered pin. */
    .site-header[data-variant='withMenu'] .site-header__logo-link {
      margin-right: auto;
    }

    .site-header__logo-link.is-home-pinned {
      transform: translateX(var(--logo-pin-shift, 0px));
      transition: transform 200ms ease;
    }
  }
</style>
