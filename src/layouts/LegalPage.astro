---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { CurrentRoute } from '../content/copy/routes';

interface Section {
  title: string;
  body: string;
}

interface Props {
  lang: 'pt' | 'en';
  currentRoute: CurrentRoute;
  label: string;
  title: string;
  intro: string;
  sections: Section[];
}

const { lang, currentRoute, label, title, intro, sections } = Astro.props;
---
<BaseLayout lang={lang} title={`Ummundu — ${title}`} currentRoute={currentRoute}>
  <Header lang={lang} variant="withMenu" />
  <main class="legal">
    <p class="legal__label">{label}</p>
    <div class="legal__content">
      <h1 class="legal__title">{title}</h1>
      <p class="legal__intro">{intro}</p>
      <div class="legal__sections">
        {sections.map((section, index) => (
          <section class="legal__section">
            <h2 class="legal__section-title">{index + 1}. {section.title}</h2>
            <p class="legal__section-body">{section.body}</p>
          </section>
        ))}
      </div>
    </div>
  </main>
  <Footer lang={lang} currentRoute={currentRoute} style="--site-footer-margin-top: 145px; --mobile-site-footer-margin-top: 108px" />
</BaseLayout>

<style>
  .legal {
    width: 100%;
  }

  .legal__label {
    position: fixed;
    top: 244px;
    left: var(--space-page-padding);
    z-index: 5;
    font-size: var(--text-label-size);
    line-height: var(--text-label-line);
    letter-spacing: var(--text-label-tracking);
    text-transform: uppercase;
    color: var(--color-text-muted-70);
    margin: 0;
  }

  .legal__content {
    width: var(--content-block-width);
    min-height: 100vh;
    margin-left: auto;
    padding-top: calc(244px + var(--text-label-line));
  }

  .legal__title {
    font-size: var(--text-page-title-size);
    line-height: var(--text-page-title-line);
    letter-spacing: var(--text-page-title-tracking);
    font-weight: normal;
    margin: 0 0 16px;
  }

  .legal__intro {
    font-size: var(--text-body-size);
    line-height: var(--text-body-line);
    letter-spacing: var(--text-body-tracking);
    margin: 0 0 68px;
  }

  .legal__sections {
    display: flex;
    flex-direction: column;
    gap: 45px;
  }

  .legal__section-title {
    font-size: var(--text-page-subtitle-size);
    line-height: var(--text-page-subtitle-line);
    letter-spacing: var(--text-page-subtitle-tracking);
    font-weight: var(--text-page-subtitle-weight);
    margin: 0 0 12px;
  }

  .legal__section-body {
    font-size: var(--text-body-size);
    line-height: var(--text-body-line);
    letter-spacing: var(--text-body-tracking);
    margin: 0;
  }

  @media (max-width: 767px) {
    .legal__label {
      top: 152px;
      left: var(--mobile-space-page-padding);
      font-size: var(--mobile-text-label-size);
      line-height: var(--mobile-text-label-line);
    }

    .legal__content {
      width: 100%;
      min-height: auto;
      margin-left: 0;
      padding-top: calc(152px + var(--mobile-text-label-line) + 30px);
    }

    .legal__title {
      font-size: var(--mobile-text-page-title-size);
      line-height: var(--mobile-text-page-title-line);
      margin: 0 0 17px;
    }

    .legal__intro {
      font-size: var(--mobile-text-body-size);
      line-height: var(--mobile-text-body-line);
      margin: 0 0 17px;
    }

    .legal__sections {
      gap: 17px;
    }

    .legal__section-title {
      font-size: var(--mobile-text-page-subtitle-size);
      line-height: var(--mobile-text-page-subtitle-line);
      margin: 0 0 7px;
    }

    .legal__section-body {
      font-size: var(--mobile-text-body-size);
      line-height: var(--mobile-text-body-line);
    }
  }
</style>
