---
import '../styles/tokens.css';
import MenuOverlay from '../components/MenuOverlay.astro';
import type { CurrentRoute } from '../content/copy/routes';

interface Props {
  lang: 'pt' | 'en';
  title: string;
  currentRoute: CurrentRoute;
}

const { lang, title, currentRoute } = Astro.props;
---
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <div class="page">
      <slot />
    </div>
    <MenuOverlay lang={lang} currentRoute={currentRoute} />
  </body>
</html>

<style>
  .page {
    padding: 0 var(--space-page-padding) 26px;
  }

  @media (max-width: 767px) {
    .page {
      padding: 0 var(--mobile-space-page-padding) 17px;
    }
  }
</style>
