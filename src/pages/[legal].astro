---
import LegalPage from '../layouts/LegalPage.astro';
import { routes } from '../content/copy/routes';
import { legalPages } from '../content/copy/legal';

export function getStaticPaths() {
  return legalPages.map(({ route, copy }) => ({
    params: { legal: routes[route].en.slice(1) },
    props: { currentRoute: route, copy: copy.en },
  }));
}

const { currentRoute, copy } = Astro.props;
---
<LegalPage lang="en" currentRoute={currentRoute} {...copy} />
